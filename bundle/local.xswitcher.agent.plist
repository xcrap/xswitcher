<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- "Open at login": XSwitcher registers this with SMAppService.agent(plistName:). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.xswitcher.agent</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/xswitcher-agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>xswitcher-agent</string>
        <string>run</string>
        <string>--no-prompt</string>
    </array>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>local.xswitcher</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Restart after a crash, but not after "Quit XSwitcher" (a clean exit). -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>

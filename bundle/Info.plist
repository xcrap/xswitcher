<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- XSwitcher.app: the main program is the small C switcher (agent/). -->
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>xswitcher-agent</string>
    <key>CFBundleIdentifier</key>
    <string>local.xswitcher</string>
    <key>CFBundleName</key>
    <string>XSwitcher</string>
    <key>CFBundleDisplayName</key>
    <string>XSwitcher</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>__VERSION__</string>
    <key>CFBundleVersion</key>
    <string>__BUILD__</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Based on InstantSpaceSwitcher by jurplel (MIT License).</string>
</dict>
</plist>
